# ─────────────────────────────────────────────────────────────────────────────
# Draper London — Enquiry Automation v1 (Shadow Mode)
# Copy to .env.local for local dev. On Render, set these in the secret store.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# --- Microsoft Graph (app-only / client credentials) ---
# Only three values are needed for auth. Object ID and Secret ID are portal-only.
TENANT_ID=your-directory-tenant-id
CLIENT_ID=your-application-client-id
CLIENT_SECRET=your-client-secret-value

# The app MUST have Mail.Read ONLY (no Mail.Send / Mail.ReadWrite), scoped via an
# Exchange Application Access Policy to just the three mailboxes below.

# --- Mailboxes (placeholders until Draper confirms the real addresses) ---
# Comma-separated. Order: sales,lettings,hello. Roles inferred by position/keyword.
MAILBOX_SALES=sales@draperlondon.example
MAILBOX_LETTINGS=lettings@draperlondon.example
MAILBOX_HELLO=hello@draperlondon.example

# --- Database ---
# Local Postgres: set DATABASE_URL and DIRECT_URL to the SAME value.
# Supabase: DATABASE_URL = pooler (port 6543, add ?pgbouncer=true), DIRECT_URL = direct (port 5432).
DATABASE_URL=postgresql://user:password@localhost:5432/draper_shadow?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/draper_shadow?schema=public

# --- Public URL (Graph delivers webhooks here; must be HTTPS with valid cert) ---
# On Render this is your web service URL, e.g. https://draper-shadow.onrender.com
PUBLIC_URL=http://localhost:3000

# --- Shared secret Graph echoes back on every notification (clientState) ---
GRAPH_CLIENT_STATE=change-me-to-a-long-random-string

# --- Secret protecting internal cron/admin endpoints ---
CRON_SECRET=change-me-to-another-long-random-string

# --- Anthropic (approved LLM provider) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5

# --- Property sync (Draper's own public site feed) ---
DRAPER_API_BASE=https://draperlondon.com

# Enrichment source for generated drafts. "null" = default (spec §7.1, mail-merge
# only). "property_db" = look the enquiry's property up in the synced Property table
# and enrich the draft with real price/beds/features. Requires `npm run properties:sync`.
ENRICHMENT=null

# --- Safety switch. Shadow mode is the ONLY supported mode in v1. ---
# Present as a tripwire: anything other than "shadow" makes the app refuse to boot.
RUN_MODE=shadow
