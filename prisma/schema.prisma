// Draper London — Enquiry Automation v1 (Shadow Mode)
// The database IS the deliverable (spec §3, §13). Everything the pipeline decides
// is recorded here; nothing is ever sent.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled connection (Supabase pooler / port 6543).
  url       = env("DATABASE_URL")
  // Migrations need a direct connection (Supabase direct / port 5432).
  // For a plain local Postgres, point DIRECT_URL at the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Mailbox {
  sales
  lettings
  hello
}

enum Source {
  rightmove
  zoopla
  website
  direct
  unknown
}

enum ParseStatus {
  full
  partial
  failed
}

// Which location the applicant's real email was resolved from (spec §6.2).
enum EmailResolvedFrom {
  from
  reply_to
  body
  none
}

enum Intent {
  viewing_request
  valuation_request
  landlord_enquiry
  tenant_or_maintenance
  supplier
  recruitment
  press
  spam
  other
}

enum SuppressionReason {
  auto_responder_guard
  one_reply_per_thread
  human_replied_first
  ineligible_intent
  repeat_enquiry
  excluded_keyword
  internal_domain // retired: no code sets this now (a genuine staff enquiry should get a reply; a non-enquiry fails the confidence gate). Kept to match the applied migration; Postgres enum values can't be safely dropped.
}

// One row per inbound message. Idempotent on graphMessageId (spec §5).
model Enquiry {
  id             String  @id @default(cuid())
  graphMessageId String  @unique
  mailbox        Mailbox
  receivedAt     DateTime // UTC, from the message (not processing time)
  source         Source  @default(unknown)

  applicantName  String?
  applicantEmail String?
  applicantPhone String?

  propertyReference String?
  propertyAddress   String?
  propertyUrl       String?

  messageBody String? // free text the applicant actually wrote

  // Personalization signals from the portal (Zoopla/Rightmove structured fields).
  budgetMax      Int? // stated ceiling, e.g. "Up to £2,500,000" -> 2500000
  budgetRaw      String? // raw text, incl. "per month" for lettings
  requirements   String? // "Type of property", e.g. "3+ bedroom property"
  interestedIn   String? // features, e.g. "Has a garden"
  aboutApplicant String? // e.g. "I have a property to sell" (valuation signal)

  rawSubject  String
  rawHeaders  Json
  rawBodyHtml String  @default("")
  rawBodyText String  @default("")

  replyTo             String?
  isReplyAllRequired  Boolean? // §6.3, determined empirically from human replies
  threadId            String? // Graph conversationId

  parseStatus     ParseStatus       @default(failed)
  parseNotes      String[]          @default([])
  emailResolvedFrom EmailResolvedFrom @default(none)

  // Classification (§6.5)
  intent           Intent?
  confidence       Float?
  classifierRaw    Json? // raw model output kept for calibration
  factualQuestion  String? // the specific question they asked, for the follow-up call

  // Grading controls (§10). Filled by Innate during the shadow week.
  gradedClassificationCorrect Boolean?
  gradingNote                 String?

  // Triage: who Craig assigns this enquiry to (null = channel default).
  assignedTo String?

  // Property match (§5.1). The listing from our Property DB this enquiry is about,
  // resolved once in the pipeline. Powers alternatives, the £2m routing, and naming
  // the property type. Confidence makes a wrong match visible rather than silent.
  matchedPropertyId String?
  matchedPrice      Int?
  matchedBedrooms   Int?
  matchedType       String?
  matchConfidence   Float?
  matchMethod       String? // reference | postcode | street_outcode | none

  // Automated routing (§3). Who the engine allocated this enquiry to, and why.
  // Craig's manual override lives in `assignedTo` above and always wins.
  routedTo     String?
  routedReason String?

  decision Decision?

  playgroundRuns PlaygroundRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mailbox])
  @@index([intent])
  @@index([parseStatus])
  @@index([receivedAt])
  @@index([threadId])
  @@index([applicantEmail])
}

// One row per enquiry. Every rule is evaluated and RECORDED, never enforced (§8).
model Decision {
  id        String  @id @default(cuid())
  enquiryId String  @unique
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  eligible        Boolean @default(false)
  ineligibleReason String?

  suppressed        Boolean            @default(false)
  suppressionReason SuppressionReason?

  duplicateOf String? // enquiry id this was grouped under (30-min window)

  // Both send-window policies computed and stored (§8). Client hasn't decided.
  wouldSendAtImmediate DateTime?
  wouldSendAtHeld      DateTime?

  generatedBody      String? // the body that WOULD have been sent. Never sent.
  generationMetadata Json? // exact prompt, model, version, params (§7.2)

  // Deferred-interface audit trail (§9). All no-op/log-only in v1.
  transportRecord  Json? // what NoOpTransport was asked to "send"
  assignmentRecord Json? // what LoggingAssignmentSink recorded

  // Real-send state (allowlisted test sending). Populated only by the sender
  // worker (scripts/send-drafts.ts). Null until the worker first touches the row.
  sentAt     DateTime? // when the reply was actually sent (null = never sent)
  sendStatus String? // pending | sending | sent | blocked | error
  sendError  String? // failure message when sendStatus = error
  sendResult Json? // audit: graph reply id, recipient, timestamp

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Graph change-notification subscriptions, one per mailbox. Renewed by cron (§5).
model Subscription {
  id             String   @id // Graph subscription id
  mailbox        Mailbox
  resource       String
  expiresAt      DateTime
  clientState    String
  notificationUrl String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mailbox])
}

// Persisted delta links so the 15-min backstop resumes where it left off (§5).
model DeltaState {
  mailbox   Mailbox  @id
  deltaLink String
  updatedAt DateTime @updatedAt
}

// Per-person in/out availability for routing (§3.5). A manual toggle now; the
// availability check is a single function so it can later read a calendar instead.
model TeamMember {
  name      String   @id
  available Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ── Prompt Playground (dev tool) ─────────────────────────────────────────────
// A read-only prompt-engineering sandbox. Lets the team A/B the reply-generation
// SYSTEM PROMPT against real sample enquiries. NOTHING here can send: the playground
// never creates a Decision, never sets a send time, never touches the transport. These
// tables store the saved prompt versions, the saved run history, and curated test sets.

// A saved version of the editable reply-generation system prompt.
model PromptVersion {
  id           String   @id @default(cuid())
  name         String // human label, e.g. "v6 - ban gushing openers"
  systemPrompt String // the full edited system prompt
  note         String? // changelog note: what changed and why
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs PlaygroundRun[]

  @@index([createdAt])
}

// One recorded Playground run: an enquiry put through the pipeline stages with a given
// prompt, and the resulting draft + per-step outputs + rule scorecard. Snapshots the
// prompt used so history survives later edits/deletes of the version.
model PlaygroundRun {
  id        String  @id @default(cuid())
  batchId   String? // groups the runs of a single "run across a test set" action
  enquiryId String
  enquiry   Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  promptName      String // label of the version/edit used at run time
  systemPrompt    String // exact system prompt used (snapshot)

  draftBody      String // the generated reply HTML (never sent)
  shape          String?
  generatedByLLM Boolean @default(false)
  wordCount      Int?
  passCount      Int     @default(0)
  failCount      Int     @default(0)
  result         Json // full PlaygroundResult (all stage outputs + scorecard)

  createdAt DateTime @default(now())

  @@index([batchId])
  @@index([enquiryId])
  @@index([createdAt])
}

// A named, curated collection of enquiries to run a prompt across (regression set).
model PlaygroundTestSet {
  id         String   @id @default(cuid())
  name       String
  enquiryIds String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Property database ────────────────────────────────────────────────────────
// Synced from Draper's own public site feed (wp-json/wp/v2/property). Powers
// "similar property" suggestions (phase 2) and enquiry enrichment. Read-only sync.

enum Channel {
  sales
  lettings
  commercial
  other
}

enum PropertyStatus {
  for_sale
  to_let
  under_offer // SSTC / under offer / let agreed
  sold
  let
  withdrawn
  other
}

model Property {
  id     String @id @default(cuid())
  wpId   Int    @unique // WordPress post id, the natural key from the feed
  slug   String
  url    String

  reference     String? // site reference_number (may differ from portal ref)
  // Extra reference tokens recovered from image/floorplan/EPC filenames (e.g. "DRL260299").
  // The feed's `reference_number` is a PRP… id for ~74% of listings, but the Draper agency
  // ref (DRLxxxxxx) that a Rightmove lead carries is embedded in the asset filenames. We
  // index those here so a Rightmove DRL lead can still reference-match a PRP-ref listing.
  refAliases    String[]       @default([])
  channel       Channel        @default(other)
  department    String? // raw e.g. "residential-sales"
  status        PropertyStatus @default(other)
  availability  String? // raw e.g. "For Sale" / "Sold" / "Under Offer"
  onMarket      Boolean        @default(false)

  propertyType   String?
  tenure         String?
  priceActual    Int? // numeric price for range matching
  priceQualifier String? // "Asking Price" / "Guide Price"
  priceFormatted String?
  currency       String?

  bedrooms       Int?
  bathrooms      Int?
  receptionRooms Int?

  title         String?
  addressStreet String?
  addressArea   String? // "location", e.g. "Hampstead, London"
  postcode      String?
  outcode       String? // "NW3" — the postcode district, for cheap proximity
  latitude      Float?
  longitude     Float?

  features    String[] @default([])
  description String?
  imageUrls   String[] @default([])

  officeName     String?
  negotiatorName String?

  modifiedAt DateTime? // from the feed (source-of-truth change time)
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  active     Boolean   @default(true) // present in the most recent sync
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([channel])
  @@index([status])
  @@index([priceActual])
  @@index([bedrooms])
  @@index([outcode])
  @@index([reference])
  @@index([active])
}
