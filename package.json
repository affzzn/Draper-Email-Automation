{
  "name": "draper-enquiry-shadow",
  "version": "1.0.0",
  "private": true,
  "description": "Draper London inbound enquiry automation — v1 shadow mode. Reads three Office 365 mailboxes, decides what it WOULD reply, records it, sends nothing.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:init": "bash scripts/localdb.sh init",
    "db:start": "bash scripts/localdb.sh start",
    "db:stop": "bash scripts/localdb.sh stop",
    "db:status": "bash scripts/localdb.sh status",
    "subscriptions:create": "tsx scripts/create-subscriptions.ts",
    "subscriptions:renew": "tsx scripts/renew-subscriptions.ts",
    "backstop:delta": "tsx scripts/delta-backstop.ts",
    "report": "tsx scripts/report.ts",
    "verify:graph": "tsx scripts/verify-graph.ts",
    "pull": "tsx scripts/pull-inbox.ts",
    "properties:sync": "tsx scripts/sync-properties.ts",
    "properties:match": "tsx scripts/find-similar.ts",
    "simulate": "tsx scripts/simulate-enquiry.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@azure/identity": "^4.5.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/client": "^6.1.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "isomorphic-fetch": "^3.0.0",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
